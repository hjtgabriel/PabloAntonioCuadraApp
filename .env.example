# Copie este archivo como «.env» y complete los valores reales.
# El archivo «.env» NUNCA debe subirse al repositorio (ver .gitignore).

# ── Base de datos ───────────────────────────────────────────────
# Motores soportados: postgresql | sqlite
DB_MOTOR=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=PabloAntonioCuadraBD
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# Carpeta «bin» de PostgreSQL. Solo hace falta si pg_dump no está en el PATH,
# que es lo habitual en Windows. Ejemplo: C:\Program Files\PostgreSQL\18\bin
PG_BIN=

# ── Aplicación ──────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── Respaldos 3-2-1 (RNF05) ─────────────────────────────────────
# Copia 1: disco principal del equipo
RESPALDO_DIR_PRIMARIO=respaldos/local
# Copia 2: segundo medio. Para cumplir de verdad los «2 medios» de la regla,
# debe ser otra unidad física, por ejemplo una memoria USB: E:/respaldos
RESPALDO_DIR_SECUNDARIO=respaldos/externo
# Copia 3: fuera del local (carpeta sincronizada con la nube)
RESPALDO_DIR_EXTERNO=

# Rotación abuelo-padre-hijo: cuántas copias conservar de cada clase
RESPALDO_RETENCION_DIARIA=7
RESPALDO_RETENCION_SEMANAL=4
RESPALDO_RETENCION_MENSUAL=12

# ── Aviso por correo del respaldo semanal ───────────────────────
# Con Gmail hay que activar la verificación en dos pasos y generar una
# «contraseña de aplicación»: la contraseña normal de la cuenta no funciona.
CORREO_ACTIVO=false
CORREO_SERVIDOR=smtp.gmail.com
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_PASSWORD=
CORREO_DESTINATARIO=
